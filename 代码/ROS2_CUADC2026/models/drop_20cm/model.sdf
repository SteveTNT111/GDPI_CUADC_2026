<?xml version="1.0"?>
<sdf version="1.6">
  <model name="drop_20cm">
    <static>true</static>
    <link name="bucket">
      <collision name="bucket_collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="bucket_visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- 临时隐藏 B 区环（2026-10-02，用户要求仿真先跑通；Ø1m 蓝盘会被桶模型当成桶，
           见错题 #65）。恢复：删掉本注释首尾即可。
      <visual name="b_ring_visual">
        <pose>0 0 -0.145 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.50</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.7 1</ambient>
          <diffuse>0.15 0.25 0.8 1</diffuse>
        </material>
      </visual>
      -->
    </link>
  </model>
</sdf>