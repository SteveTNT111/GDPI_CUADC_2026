    <!-- ================================================================
         仿真相机（B1 camera_node 图像源）
         用途：Gazebo 里没有真 D435i，用 GZ camera/depth_camera 传感器出图，
               由 camera_node.py 的 gz.transport13 桥接转发到 /vision/*。
         话题：/camera/color/image (gz.msgs.Image, RGB_INT8)
               /camera/depth/image (gz.msgs.Image, R_FLOAT32 米)
         安装（与真机/代码语义一致，2026-09-30 由前下 45° 改为正下方）：
           - 位置：CG 正下方（x=0，机体下表面之下）；
           - 姿态：pitch=+90° → 光轴（+X）指向机体正下方；
             gz 图像"上"方向 = 相机 +Z = 机体 +X → 图像顶部朝机头；
             X_body(前)=-Y_cam, Y_body(右)=X_cam, Z_body(下)=Z_cam（detector 假设）。
           - 备注：detector 的 camera_mount_z 需按本模型实际偏移赋值（T4 标定）。
         ================================================================ -->
    <link name="camera_link">
      <pose>0 0 -0.12 0 1.5707963267948966 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-5</iyy>
          <iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <sensor name="color_camera" type="camera">
        <topic>/camera/color/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="depth_camera" type="depth_camera">
        <topic>/camera/depth/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- plugins -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
