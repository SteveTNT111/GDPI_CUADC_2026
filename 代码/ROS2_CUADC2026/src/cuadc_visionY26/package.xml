<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuadc_visionY26</name>
  <version>0.1.0</version>
  <description>CUADC 2026 视觉包 —— YOLO26 ONNX 推理版本。复用 cuadc_vision 的消息定义与话题名，
               训练/导出 YOLO26 (best_yolo26.onnx) 时用本包；YOLOv8 用 cuadc_vision。二者可互换。</description>
  <maintainer email="lab@unknown.invalid">GDPI CUADC Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 复用 cuadc_vision 的 msg/*（YoloDetection / YoloDetections / BucketInfo / MissionStatus / GeoTarget），
       这样控制脚本 import cuadc_vision.msg 不变，话题类型也不变。 -->
  <depend>cuadc_vision</depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>rclpy</depend>
  <depend>python3-numpy</depend>

  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
