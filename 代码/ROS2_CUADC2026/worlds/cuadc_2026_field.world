<?xml version="1.0" ?>
<sdf version="1.8">
  <!--
    CUADC 2026 多旋翼无人机侦察与救援 - 比赛场地（ROS2 / Gazebo Harmonic 适配版）
    ============================================================================
    由 `备赛文档/机架电装选型/cuadc_2026_field.world` 适配而来：
      1. physics: ode(Gazebo Classic) -> dartsim(Gazebo Harmonic)，并显式加载
         物理/传感器/场景系统插件（参数对齐 ardupilot_gazebo 官方 iris_warehouse.sdf）。
      2. 补齐缺失的可复用模型：model://drop_15cm / drop_20cm / drop_25cm / recon_20cm
         （位于 ~/ROS2_CUADC2026/models/，白色圆筒按比赛规则尺寸）。
      3. 场地几何 / 颜色 / 筒位姿沿用原 world；其中**投放区/侦察区长宽按规则图1修正**
         （原 world 画反：沿航线 8m / 横向 5m → 沿航线 5m / 横向 8m，依据见下）。
         坐标与规则一致：
         X+ = 飞行前进方向（起降区 → 投放区 → 侦察区），Y+ = 左侧，Z+ = 上方。
      - 起降区: 33m × 8m（X: -3~30, Y: -4~4），起降点圆心 (0,0)，起飞线 X=2
      - 投放区: 5m(沿航线) × 8m(横向)，中心 X=32.5, Y=0，X: 30~35, Y: -4~4（起降点前 30m）
      - 侦察区: 5m(沿航线) × 8m(横向)，中心 X=57.5, Y=0，X: 55~60, Y: -4~4（起降点前 55m）
      - 尺寸依据：竞赛规则 3.1.2/3.1.3 + 图1（30m + 投放区 5m + 20m = 55m；
        图1 中 8m 标在横向、5m 标在沿航线方向，与规则"距离起降点 55m"自洽）。
  -->
  <world name="cuadc_2026_field">

    <!-- ====== 物理引擎（Harmonic/dartsim，对齐官方 iris_warehouse.sdf）====== -->
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- ====== 标准系统插件（物理/传感器/用户指令/场景广播）====== -->
    <plugin filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ====== 地面（灰色 200m × 200m = 原 world）====== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== 起降区（水泥色跑道，蓝色圆盘 + 白色 H = 起降点，白色线条 = 起飞线）====== -->
    <model name="takeoff_zone">
      <static>true</static>
      <!-- 与边框/源 world 对齐：X -3~30 居中 = 13.5（原先误写 2，地面块偏到 -14.5~18.5） -->
      <pose>13.5 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>33 8 0.005</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.15 0.25 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 起降区边框 4 条黄线 -->
    <model name="takeoff_border_N"><static>true</static>
      <pose>13.5 4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>33 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="takeoff_border_S"><static>true</static>
      <pose>13.5 -4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>33 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="takeoff_border_E"><static>true</static>
      <pose>30 0 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="takeoff_border_W"><static>true</static>
      <pose>-3 0 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- 起飞线 X=2 白色 -->
    <model name="takeoff_line">
      <static>true</static>
      <pose>2 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.04 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- H 形着陆标记（白色，居中于蓝色起降圆盘；沿航线方向正读：两根竖杠沿 X、横杠沿 Y） -->
    <model name="landing_h_horiz">
      <static>true</static>
      <pose>0 0 0.010 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 0.44 0.003</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="landing_h_left">
      <static>true</static>
      <pose>0 -0.18 0.010 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.52 0.08 0.003</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="landing_h_right">
      <static>true</static>
      <pose>0 0.18 0.010 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.52 0.08 0.003</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- ================================================================== -->
    <!-- 投放区: 5m(沿航线) × 8m(横向) 水泥色地面（与整条跑道一致） + 白色边框 + 蓝色角标，中心 X=32.5 -->
    <!-- ================================================================== -->
    <model name="drop_zone">
      <static>true</static>
      <pose>32.5 0 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 8 0.001</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 投放区边框 4 条白线 -->
    <model name="drop_border_N"><static>true</static>
      <pose>32.5 4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>5 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="drop_border_S"><static>true</static>
      <pose>32.5 -4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>5 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="drop_border_E"><static>true</static>
      <pose>35 0 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="drop_border_W"><static>true</static>
      <pose>30 0 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- 投放区四角蓝色方块 (30cm × 30cm) -->
    <model name="drop_corner_NE"><static>true</static>
      <pose>35 4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material></visual></link></model>
    <model name="drop_corner_NW"><static>true</static>
      <pose>30 4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material></visual></link></model>
    <model name="drop_corner_SE"><static>true</static>
      <pose>35 -4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material></visual></link></model>
    <model name="drop_corner_SW"><static>true</static>
      <pose>30 -4 0.004 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material></visual></link></model>

    <!-- 投放区: 圆筒 1（空心, Ø15cm, H=30cm, 壁厚6mm, B环内嵌） -->
    <include>
      <name>drop_cylinder_1</name>
      <uri>model://drop_15cm</uri>
      <pose>31.5 -1.2 0.15 0 0 0</pose>
    </include>

    <!-- 投放区: 圆筒 2（空心, Ø20cm, H=30cm, 壁厚6mm, B环内嵌） -->
    <include>
      <name>drop_cylinder_2</name>
      <uri>model://drop_20cm</uri>
      <pose>33.5 0.8 0.15 0 0 0</pose>
    </include>

    <!-- 投放区: 圆筒 3（空心, Ø25cm, H=30cm, 壁厚6mm, B环内嵌） -->
    <include>
      <name>drop_cylinder_3</name>
      <uri>model://drop_25cm</uri>
      <pose>32.5 -0.3 0.15 0 0 0</pose>
    </include>

    <!-- 跑道补齐段：投放区→侦察区之间（X 35~55），与各区域同水泥色，使跑道连续 -->
    <model name="runway_fill_35_55">
      <static>true</static>
      <pose>45 0 0.0004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 8 0.0008</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- 侦察区: 5m(沿航线) × 8m(横向) 灰色跑道 + 白色边框 + 橙色角标，中心 X=57.5     -->
    <!-- ================================================================== -->
    <model name="recon_zone">
      <static>true</static>
      <pose>57.5 0 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 8 0.001</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 侦察区边框：4 条白色线 -->
    <model name="recon_border_N"><static>true</static>
      <pose>57.5 4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>5 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="recon_border_S"><static>true</static>
      <pose>57.5 -4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>5 0.08 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="recon_border_E"><static>true</static>
      <pose>60 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="recon_border_W"><static>true</static>
      <pose>55 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.08 8 0.002</size></box></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- 侦察区四角橙色方块 (30cm × 30cm) -->
    <model name="recon_corner_NE"><static>true</static>
      <pose>60 4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.7 0.3 0.05 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual></link></model>
    <model name="recon_corner_NW"><static>true</static>
      <pose>55 4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.7 0.3 0.05 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual></link></model>
    <model name="recon_corner_SE"><static>true</static>
      <pose>60 -4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.7 0.3 0.05 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual></link></model>
    <model name="recon_corner_SW"><static>true</static>
      <pose>55 -4 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.3 0.003</size></box></geometry>
      <material><ambient>0.7 0.3 0.05 1</ambient><diffuse>0.85 0.4 0.1 1</diffuse></material></visual></link></model>

    <!-- 侦察区: 圆筒 1（空心, Ø20cm, H=15cm, 壁厚6mm） -->
    <include>
      <name>recon_cylinder_1</name>
      <uri>model://recon_20cm</uri>
      <pose>56.5 -1.5 0.075 0 0 0</pose>
    </include>

    <!-- 侦察区: 圆筒 2 -->
    <include>
      <name>recon_cylinder_2</name>
      <uri>model://recon_20cm</uri>
      <pose>57.5 -1.5 0.075 0 0 0</pose>
    </include>

    <!-- 侦察区: 圆筒 3 -->
    <include>
      <name>recon_cylinder_3</name>
      <uri>model://recon_20cm</uri>
      <pose>58.5 -1.5 0.075 0 0 0</pose>
    </include>

    <!-- 侦察区: 圆筒 4 -->
    <include>
      <name>recon_cylinder_4</name>
      <uri>model://recon_20cm</uri>
      <pose>56.5 1.5 0.075 0 0 0</pose>
    </include>

    <!-- 侦察区: 圆筒 5 -->
    <include>
      <name>recon_cylinder_5</name>
      <uri>model://recon_20cm</uri>
      <pose>58.5 1.5 0.075 0 0 0</pose>
    </include>

    <!-- ====== 3个危险化学品标识（12cm × 12cm 小方块，放在其中3个侦察筒内）====== -->
    <model name="hazard_sign_1">
      <static>true</static>
      <pose>56.5 -1.5 0.16 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>0.9 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hazard_sign_2">
      <static>true</static>
      <pose>58.5 -1.5 0.16 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 1 0 1</ambient>
            <diffuse>0.2 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hazard_sign_3">
      <static>true</static>
      <pose>57.5 1.5 0.16 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.6 0 1</ambient>
            <diffuse>0.9 0.5 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- 距离标尺（Y=+4m = 投放区/侦察区北侧角点连线；X=0~60m，1m 刻度，
         5m 中刻度 / 10m 长刻度与数字）；由 scripts/gen_distance_ruler.py 生成 -->
    <!-- ================================================================== -->
    <include>
      <name>distance_ruler</name>
      <uri>model://distance_ruler</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ================================================================== -->
    <!-- Iris 无人机（跟原始 runway 世界一模一样，不自作聪明加任何东西） -->
    <!-- ================================================================== -->
    <model name="iris_demo">
      <include>
        <uri>model://iris_with_ardupilot</uri>
      </include>
    </model>

  </world>
</sdf>